{
    "name": "phpsoftbox/cs-fixer",
    "description": "CS Fixer rules for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "require": {
        "php": "^8.5",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpsoftbox/cli-app": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\CsFixer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\CsFixer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/psb-cs-fixer"
    ],
    "scripts": {
        "cs:fix": "bin/psb-cs-fixer fix",
        "cs:check": "bin/psb-cs-fixer check --diff",
        "test": "phpunit"
    },
    "prefer-stable": true
}
