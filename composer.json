{
    "name": "phpsoftbox/cs-fixer",
    "description": "CS Fixer rules for the PhpSoftBox framework",
    "type": "library",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpsoftbox/cli-app": "^0.1.0@beta"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\CsFixer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\CsFixer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/psb-cs-fixer"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "beta",
    "repositories": [
        { "type": "vcs", "url": "git@github.com:phpsoftbox/cli-app.git", "no-api": true }
    ]
}
